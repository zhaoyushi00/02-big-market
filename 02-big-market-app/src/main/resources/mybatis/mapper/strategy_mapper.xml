<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhaoyushi.infrastructure.persistent.dao.IStrategyDao">

    <resultMap id="dataMap" type="com.zhaoyushi.infrastructure.persistent.po.Strategy">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="strategy_desc" property="strategyDesc"/>
        <result column="rule_model" property="ruleModel"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryStrategyList" resultMap="dataMap">
        select strategy_id
        from big_market.strategy
        limit 10
    </select>
    <!-- 按策略ID查询策略信息（id 对应 DAO 方法 queryStrategyByStrategyId） -->
    <select id="queryStrategyByStrategyId" resultMap="dataMap">
        <!-- 查询策略核心字段，rule_models 为修正后的列名（原为 rule_model，与建表列名不一致） -->
        select strategy_id, strategy_desc, rule_models
        from big_market.strategy
        where strategy_id = #{strategyId}
    </select>

</mapper>
