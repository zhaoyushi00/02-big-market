<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhaoyushi.infrastructure.persistent.dao.IRaffleActivityAccountDayDao">

    <resultMap id="dataMap" type="com.zhaoyushi.infrastructure.persistent.po.RaffleActivityAccountDay">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="activity_id" property="activityId"/>
        <result column="day" property="day"/>
        <result column="day_count" property="dayCount"/>
        <result column="day_count_surplus" property="dayCountSurplus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <!-- 插入日账户：日账户首次建立时写入，额度与剩余额度入参给定 -->
    <insert id="insertActivityAccountDay" parameterType="com.zhaoyushi.infrastructure.persistent.po.RaffleActivityAccountDay">
        insert into raffle_activity_account_day(
            user_id, activity_id, day, day_count, day_count_surplus, create_time, update_time)
        values
            (#{userId}, #{activityId}, #{day}, #{dayCount}, #{dayCountSurplus}, now(), now())
    </insert>

    <!-- 扣减日账户额度：当日剩余次数减 1；where 限制剩余次数大于 0，防止扣成负数 -->
    <update id="updateActivityAccountDaySubtractionQuota" parameterType="com.zhaoyushi.infrastructure.persistent.po.RaffleActivityAccountDay">
        update raffle_activity_account_day
        set day_count_surplus = day_count_surplus - 1, update_time = now()
        where user_id = #{userId} and activity_id = #{activityId} and day = #{day} and day_count_surplus > 0
    </update>
    <!-- 按用户 + 活动 + 日期查询日账户（用于参与活动前的日额度校验） -->
    <select id="queryActivityAccountDayByUserId"
            resultType="com.zhaoyushi.infrastructure.persistent.po.RaffleActivityAccountDay" resultMap="dataMap">
        select user_id, activity_id, day, day_count, day_count_surplus
        from raffle_activity_account_day
        where user_id = #{userId} and activity_id = #{activityId} and day = #{day}
    </select>
</mapper>
